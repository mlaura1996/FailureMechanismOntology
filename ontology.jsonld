      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Class imported from the https://w3id.org/hmo# ontology, to define vertical, in plane and out of plane behaviour of the assessed wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Masonry Quality Index"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AbsenceOfTopCurbstone",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A vulnerability that consists in the absence of curbstone in the roof supported by the wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Absence of Top Curbstone"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AverageInPlaneBehaviour",
