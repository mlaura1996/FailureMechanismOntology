        "@list": [
          {
            "@id": "https://pi.pauwel.be/voc/buildingelement#Wall"
          },
          {
            "@id": "https://w3id.org/hmo#MasonryWall"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/dot#hasCausation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "It indicates the relationship between a damage and the failure mechanism that causes it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/dot#StructuralDamage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Has causation"
      }
