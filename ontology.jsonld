      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#InPlaneBehaviour",
      "https://w3id.org/fmo#WallBehaviour"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "It indicates a type of behaviour that is within the average range of how masonry walls behave when subjected to in plane load."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Average in plane behaviour"
      }
