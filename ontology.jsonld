      {
        "@language": "en",
        "@value": "A type of (in plane) wall behaviour that is considered good based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
