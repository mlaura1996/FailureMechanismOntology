        "@value": true
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total out of plane value less or equal than 10 and greater than 7, than the Masonry Wall has an good out of plane behaviour"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
