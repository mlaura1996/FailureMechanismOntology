      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a masonry wall has a vulnerability that is ‘absence of top chains’, then it has an occurring mechanism that is ‘partial overturn."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Partial overturn - chains"
