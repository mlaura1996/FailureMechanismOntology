      {
        "@language": "en",
        "@value": "A specific vulnerability in the wall consists in the presence of thrusting elements, which facilitate out-of-plane movement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Presence of horizontal thrust"
      }
    ]
  },
  {
    "@id": "_:nb9c367e4985148a5abcacf59dd7ea8eeb250",
    "@type": [
      "http://www.w3.org/2003/11/swrl#Imp"
    ],
    "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total in plane value less or equal than 3 and greater or equal than 0, than the Masonry Wall has an inadequate In plane behaviour"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Inadequate in plane behavior"
      }
    ],
    "http://www.w3.org/2003/11/swrl#body": [
