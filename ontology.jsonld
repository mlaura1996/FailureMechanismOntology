      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A vulnerability consisting of the presence of deformable slabs supported by the wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
