        "@id": "https://w3id.org/fmo#FailureMechanism"
      }
    ]
  },
  {
    "@id": "https://w3id.org/hmo#MasonryWall",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "imported from https://w3id.org/hmo, to apply the vulnerability - behaviour - failure mechanism to a hmo:MasonryWall"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Masonry Wall"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://pi.pauwel.be/voc/buildingelement#Wall"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#PartialOverturn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#FailureMechanism"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific mechanism consisting of the total rotation of part of a wall out of the plane."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Partial Overturn"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#mcn",
    "@type": [
      "http://www.w3.org/2003/11/swrl#Variable"
