      "https://w3id.org/fmo#WallBehaviour"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A type of (in plane) wall behaviour that is considered inadequate based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Inadequate in plane behaviour"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AbsenceOfTopChains",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A vulnerability that consists in the absence of chains in the roof supported by the wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Absence of Top Chains"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AbsenceOfTopCurbstone",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A vulnerability that consists in the absence of curbstone in the roof supported by the wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Absence of Top Curbstone"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#Crack",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A type of damage, which is modelled as a specific subclass of https://w3id.org/dot#StructuralDamage. It may indicate the presence of an ongoing mechanism."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Crack"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/dot#StructuralDamage"
      }
    ]
  },
