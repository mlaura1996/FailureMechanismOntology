      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#ExcessiveSlenderness",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "A specific vulnerability consisting of excessive slenderness of the wall."
      },
      {
        "@language": "en",
        "@value": "Excessive slenderness"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AverageOutOfPlaneBehaviour",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#OutOfPlaneBehaviour",
      "https://w3id.org/fmo#WallBehaviour"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "It indicates a type of behaviour (based on the values of https://w3id.org/hmo#MasonryQualityIndex) that is within the average range of how masonry walls behave when subjected to a out of plane load."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Average out of plane behaviour"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#TotalOverturn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#FailureMechanism"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific mechanism consisting of the total rotation of the entire wall out of the plane."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Total Overturn"
      }
    ]
  },
  {
    "@id": "https://pi.pauwel.be/voc/buildingelement#Wall",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Class imported from https://pi.pauwel.be/voc/buildingelement ontology, to map an IFC wall with a masonry wall, in the ontology-BIM model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Wall"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#MQI",
    "@type": [
      "http://www.w3.org/2003/11/swrl#Variable"
    ]
  },
  {
    "@id": "_:nb9c367e4985148a5abcacf59dd7ea8eeb50",
    "@type": [
      "http://www.w3.org/2003/11/swrl#Imp"
    ],
    "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "If a masonry wall has a vulnerability that is ‘excessive slenderness’ and a vulnerability that is ‘absence of top chains’ and a vulnerability that is ‘presence of horizontal thrusts’ and a behaviour that is ‘inadequate out of plane behaviour’, then it has an occurring mechanism that is ‘horizontal bending’."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Horizontal bending - absence of top chains"
      }
    ],
    "http://www.w3.org/2003/11/swrl#body": [
      {
        "@id": "_:nb9c367e4985148a5abcacf59dd7ea8eeb51"
      }
    ],
