    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Imported from the https://w3id.org/hmo ontology, it relates a masonry wall to the value of the masonry quality index."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nb9c367e4985148a5abcacf59dd7ea8eeb4"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Has Masonry Quality Index"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/hmo#MasonryQualityIndex"
      }
    ]
  },
  {
