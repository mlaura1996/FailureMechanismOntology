  {
    "@id": "https://w3id.org/fmo#HorizontalBending",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#FailureMechanism"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific mechanism manifested by the expulsion of material from the top zone of the wall and the detachment of wedge-shaped bodies \naccompanied by the formation of oblique and vertical cylindrical hinges due to out-of-plane actions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Horizontal Bending"
      }
    ]
  },
