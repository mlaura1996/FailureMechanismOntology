    ]
  },
  {
    "@id": "http://purl.org/dc/terms/license",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fmo#InPlaneFailure",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#FailureMechanism"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific mechanism that do not involve out of plane overturning, but in plane craking/failure."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "In Plane Failure"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/issued",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fmo#DiagonalAndVerticalCracks",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/dot#StructuralDamage",
      "https://w3id.org/fmo#Crack"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Diagonal and vertical cracks in the same wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Diagonal and vertical cracks"
      }
    ],
    "https://w3id.org/dot#hasCausation": [
      {
        "@id": "https://w3id.org/fmo#HorizontalBending"
      }
    ]
  },
  {
    "@id": "https://w3id.org/dot#StructuralDamage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Imported from https://w3id.org/dot.Indicates damage in a hmo:MasonryWall. In the context of failure mechanisms, it helps to understand when a mechanism is present in a wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Structural Damage"
      }
    ]
  },
  {
    "@id": "https://w3id.org/fmo#AbsenceOfIntermediateCurbstone",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/fmo#Vulnerability"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A vulnerability that consists in the absence of curbstones in the intermediate floors of the slabs supported by the wall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Absence of intermediate curbstone"
      }
    ]
  },
  {
