  <rdf:Description rdf:about="https://w3id.org/fmo#ExcessiveSlenderness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdfs:label xml:lang="en">A specific vulnerability consisting of excessive slenderness of the wall.</rdfs:label>
    <rdfs:label xml:lang="en">Excessive slenderness</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b212">
