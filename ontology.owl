    <rdfs:label>Has damage</rdfs:label>
    <rdfs:comment>imported from https://w3id.org/dot ; used to describe damage hmo:MasonryWall, and understand its corration with possible ongoing mechanisms</rdfs:comment>
    <rdfs:domain rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb1"/>
    <rdfs:range rdf:resource="https://w3id.org/dot#StructuralDamage"/>
