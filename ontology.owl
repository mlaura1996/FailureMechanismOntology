  <rdf:Description rdf:about="https://w3id.org/fmo#VerticalCrackEntireWallAtIntersection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/dot#StructuralDamage"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Crack"/>
    <rdfs:label>Vertical crack near intersection</rdfs:label>
    <rdfs:comment xml:lang="en">A vertical crack occurring at the intersection between walls.</rdfs:comment>
    <ns3:hasCausation rdf:resource="https://w3id.org/fmo#TotalOverturn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b118">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Average vertical Behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total Vertical value less or equal than 5 and greater than 2.5, than the Masonry Wall has an average vertical behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b119"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b133"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b22">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQIv"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQITotalVertical"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b225">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Horizontal bending - absence of top curbstone</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘excessive slenderness’ and a vulnerability that is ‘absence of top curbstone’ and a vulnerability that is ‘presence of horizontal thrusts’ and a behaviour that is ‘inadequate out of plane behaviour’, then it has an occurring mechanism that is ‘horizontal bending’.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b226"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b234"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b261">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#InadequateOutOfPlaneBehaviour"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#OutOfPlaneBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Out Of Plane Behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the behaviour of a wall subjected to an out of plane load.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
  </rdf:Description>
