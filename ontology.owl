    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasMasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/modified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b67">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate out of plane behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total out of plane value less or equal than 4 and greater or equal than 0, than the Masonry Wall has an inadequate out of plane behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b68"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b82"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b173">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Total overturn - curstone -chain</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘absence of intermediate curbstone’ and has a vulnerability that is ‘absence of top chains', then it has an occurring mechanism that is ‘total overturn.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b174"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b178"/>
  </rdf:Description>
