>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b152">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Mechanism and damage</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a wall has a damage, and the damage is caused by a specific mechanism, than the wall has a ongoing mechanism</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b153"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b157"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b242">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#DeformableFloors"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b245">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b246"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b213">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#PartialOverturn"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasOccurringMechanism"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#AbsenceOfIntermediateChains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdfs:label xml:lang="en">Absence of intermediate chains</rdfs:label>
    <rdfs:comment xml:lang="en">A vulnerability that consists in the absence of chains in the intermediate floors of the slabs supported by the wall.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b209">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Partial overturn - curbstone</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘absence of top curbstone, then it has an occurring mechanism that is ‘partial overturn.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b210"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b212"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#MQITotalInPlane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Masonry Quality Index total value for in plane loads</rdfs:label>
    <rdfs:comment>Defines the total value of MQI for in plane loads. Imported from https://w3id.org/hmo.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/hmo#MasonryQualityIndex"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b41">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <ns1:arguments rdf:nodeID="n49030e428ac1404292800e1d33196617b42"/>
    <ns1:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b48">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b49"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b150">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b151"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b206">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#AbsenceOfTopChains"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b214">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Horizontal bending - absence of top chains</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘excessive slenderness’ and a vulnerability that is ‘absence of top chains’ and a vulnerability that is ‘presence of horizontal thrusts’ and a behaviour that is ‘inadequate out of plane behaviour’, then it has an occurring mechanism that is ‘horizontal bending’.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b215"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b223"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b31">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b32"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#HorizontalAndVerticalCracks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/dot#StructuralDamage"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Crack"/>
    <rdfs:label>Horizontal and vertical cracks</rdfs:label>
    <rdfs:comment>Vertical and horizontal cracks in the same wall.</rdfs:comment>
    <ns3:hasCausation rdf:resource="https://w3id.org/fmo#VerticalBending"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b141">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQIv"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQITotalVertical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/dot#StructuralDamage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Structural Damage</rdfs:label>
    <rdfs:comment xml:lang="en">Imported from https://w3id.org/dot.Indicates damage in a hmo:MasonryWall. In the context of failure mechanisms, it helps to understand when a mechanism is present in a wall.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b257">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate Out Of Plane Behaviour Vulnerability</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘inadequate out of plane behaviour’, then it has an occurring mechanism that is ‘out of plane failure’.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b258"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b260"/>
  </rdf:Description>
