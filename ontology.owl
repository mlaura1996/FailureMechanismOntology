    <ns1:argument1 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQIv"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQITotalOutOfPlane"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Maria Laura Leonardi, Stefano Cursi, Elena Gigliarelli, José Granja, Daniel Oliveira, Miguel Azenha.</dcterms:creator>
    <dcterms:description>An ontology to represent the failure mechanism of unreinforced masonry structures</dcterms:description>
    <dcterms:issued>2024-04-29</dcterms:issued>
    <dcterms:license>https://creativecommons.org/licenses/by/1.0</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
    <dcterms:title xml:lang="en">Failure Mechanism Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>fmo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/fmo#</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Version 0.2: rules corrected so that a reasoner can execute them; see CHANGELOG.md.</rdfs:comment>
    <owl:versionInfo>0.2</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#InPlaneFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:label xml:lang="en">In Plane Failure</rdfs:label>
    <rdfs:comment xml:lang="en">A specific mechanism that do not involve out of plane overturning, but in plane craking/failure.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#hasMasonryQualityIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Masonry Quality Index</rdfs:label>
    <rdfs:comment>Imported from the https://w3id.org/hmo ontology, it relates a masonry wall to the value of the masonry quality index.</rdfs:comment>
