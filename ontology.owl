  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#FailureMechanism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Failure Mechanism</rdfs:label>
    <rdfs:comment>Indicates the collapse mechanism expected from a specific hmo:MasonryWall.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <owl:disjointWith rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
  </rdf:Description>
