  <rdf:Description rdf:about="https://w3id.org/fmo#InadequateOutOfPlaneBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#OutOfPlaneBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Inadequate out of plane behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">A type of (out of plane) wall behaviour that is considered inadequate based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
