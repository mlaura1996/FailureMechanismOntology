  <rdf:Description rdf:about="https://w3id.org/fmo#VerticalBending">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:label xml:lang="en">Vertical Bending</rdfs:label>
    <rdfs:comment xml:lang="en">A specific mechanism manifested with the formation a horizontal cylindrical hinge that divides the wall into two blocks and is described by the mutual rotation of the same around this axis by out-of-plane actions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb169">
