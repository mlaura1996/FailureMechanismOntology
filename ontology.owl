    <ns1:argument2 rdf:resource="https://w3id.org/fmo#PresenceOfHorizontalThrust"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b247">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate in plane behaviour vulnerability</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘inadequate in plane behaviour’, then it has a vulnerability that is ‘inadequate in plane behaviour’.</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b248"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b250"/>
  </rdf:Description>
