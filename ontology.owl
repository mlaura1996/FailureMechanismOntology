    <rdf:type rdf:resource="https://w3id.org/fmo#InPlaneBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Good in plane behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">A type of (in plane) wall behaviour that is considered good based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb77">
