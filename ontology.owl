    <rdfs:comment xml:lang="en">A type of (out of plane) wall behaviour that is considered good based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#VerticalCrackEntireWallAtIntersection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/dot#StructuralDamage"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Crack"/>
    <rdfs:label>Vertical crack near intersection</rdfs:label>
    <rdfs:comment xml:lang="en">A vertical crack occurring at the intersection between walls.</rdfs:comment>
    <ns3:hasCausation rdf:resource="https://w3id.org/fmo#TotalOverturn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb103">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Good vertical behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total vertical value less or equal than 10 and greater than 5, than the Masonry Wall has a good vertical behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb104"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb118"/>
  </rdf:Description>
