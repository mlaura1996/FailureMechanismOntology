    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb232">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb233"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb98">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate Vertical Behaviour Vulnerability</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a behaviour that is ‘inadequate vertical behaviour’, then it has a vulnerability that is ‘inadequate vertical behaviour’.</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb99"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb101"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#GoodVerticalBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#VerticalBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Good vertical behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">The vertical wall behaviour that is considered good based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb53">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb54"/>
    <rdf:rest rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb55"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb51">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb52"/>
    <rdf:rest rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb53"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb204">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#AverageVerticalBehaviour"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasBehaviour"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb144">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb145"/>
    <rdf:rest rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb148"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb171">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Average out of plane behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total Out Of Plane Value less or equal than 7 and greater than 4, than the Masonry Wall has an average out of Plane behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb172"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb186"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb62">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb63"/>
    <rdf:rest rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb64"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#InPlaneFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:label xml:lang="en">In Plane Failure</rdfs:label>
    <rdfs:comment xml:lang="en">A specific mechanism that do not involve out of plane overturning, but in plane craking/failure.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb88">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>In plane failure</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘inadequate in plane behaviour’, than it has an occurring mechanism that is ‘in plane failure’.</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb89"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb91"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb45">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Partial overturn - curbstone</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a masonry wall has a vulnerability that is ‘absence of top curbstone, then it has an occurring mechanism that is ‘partial overturn.</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb46"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb48"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb36">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb37"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb239">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb240"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb196">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <ns1:arguments rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb197"/>
    <ns1:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb32">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#GoodInPlaneBehaviour"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasBehaviour"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb44">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#PartialOverturn"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasOccurringMechanism"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb231">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#AbsenceOfIntermediateChains"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb109">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQIv"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQITotalVertical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#TotalOverturn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:label xml:lang="en">Total Overturn</rdfs:label>
    <rdfs:comment xml:lang="en">A specific mechanism consisting of the total rotation of the entire wall out of the plane.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
