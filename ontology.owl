  <rdf:Description rdf:about="https://w3id.org/fmo#InadequateVerticalBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#VerticalBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Inadequate Vertical Behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">A type of (vertical) wall behaviour that is considered inadequate based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#PresenceOfHorizontalThrust">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdfs:label xml:lang="en">Presence of horizontal thrust</rdfs:label>
    <rdfs:comment xml:lang="en">A specific vulnerability in the wall consists in the presence of thrusting elements, which facilitate out-of-plane movement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb253">
