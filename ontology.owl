    <ns1:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb168">
    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb31">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb32"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb245">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#AbsenceOfIntermediateCurbstone"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb16">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Good in plane behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total In Plane Value less or equal than 10 and greater than 5, than the Masonry Wall has an good in plane behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb17"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb31"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb170">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#InadequateOutOfPlaneBehaviour"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasBehaviour"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb22">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQIv"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#MQITotalInPlane"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#InadequateInPlaneBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#InPlaneBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Inadequate in plane behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">A type of (in plane) wall behaviour that is considered inadequate based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb222">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Mechanism and damage</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a wall has a damage, and the damage is caused by a specific mechanism, than the wall has a ongoing mechanism</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb223"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb227"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb250">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate in plane behavior</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total in plane value less or equal than 3 and greater or equal than 0, than the Masonry Wall has an inadequate In plane behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb251"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb265"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#HorizontalAndVerticalCracks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/dot#StructuralDamage"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Crack"/>
    <rdfs:label>Horizontal and vertical cracks</rdfs:label>
    <rdfs:comment>Vertical and horizontal cracks in the same wall.</rdfs:comment>
    <ns3:hasCausation rdf:resource="https://w3id.org/fmo#VerticalBending"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/hmo#hasMasonryQualityIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has Masonry Quality Index</rdfs:label>
    <rdfs:comment>Imported from the https://w3id.org/hmo ontology, it relates a masonry wall to the value of the masonry quality index.</rdfs:comment>
    <rdfs:domain rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb4"/>
    <rdfs:range rdf:resource="https://w3id.org/hmo#MasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#AverageInPlaneBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#InPlaneBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Average in plane behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">It indicates a type of behaviour that is within the average range of how masonry walls behave when subjected to in plane load.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb178">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb179"/>
    <rdf:rest rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb182"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb262">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <ns1:arguments rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb263"/>
    <ns1:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#FacilitatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Facilitated by</rdfs:label>
    <rdfs:comment>Indicates the relationship between a failure mechanism and the vulnerability that facilitates it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:range rdf:resource="https://w3id.org/fmo#Vulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb97">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#InadequateOutOfPlaneBehaviour"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb188">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Average vertical Behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total Vertical value less or equal than 5 and greater than 2.5, than the Masonry Wall has an average vertical behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb189"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb203"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Maria Laura Leonardi, Stefano Cursi, Elena Gigliarelli, José Granja, Daniel Oliveira, Miguel Azenha.</dcterms:creator>
    <dcterms:description>An ontology to represent the failure mechanism of unreinforced masonry structures</dcterms:description>
    <dcterms:issued>2024-04-29</dcterms:issued>
    <dcterms:license>https://creativecommons.org/licenses/by/1.0</dcterms:license>
    <dcterms:modified>2024-04-29</dcterms:modified>
    <dcterms:title xml:lang="en">Failure Mechanism Ontology</dcterms:title>
    <rdfs:comment>Version 0.1</rdfs:comment>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</owl:versionInfo>
    <preferredNamespacePrexif>fmo</preferredNamespacePrexif>
    <preferredNamespaceUri>https://w3id.org/fmo#</preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb205">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Inadequate vertical behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total vertical value less or equal than 2.5 and greater or equal than 0, than the Masonry Wall has an inadequate vertical behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb206"/>
    <ns1:head rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb220"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb181">
    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#float">7.0</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb216">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb217"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
