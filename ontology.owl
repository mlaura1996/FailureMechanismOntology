  <rdf:Description rdf:about="https://w3id.org/fmo#hasVulnerability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Has Vulnerability</rdfs:label>
    <rdfs:comment>Relates the masonry wall to the vulnerability that characterised them.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n49030e428ac1404292800e1d33196617b13"/>
    <rdfs:range rdf:resource="https://w3id.org/fmo#Vulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#AverageVerticalBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#VerticalBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Average Vertical Behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">It indicates a type of behaviour that is within the average range (based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex) of how masonry walls behave when subjected to a vertical load.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#AbsenceOfIntermediateCurbstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Vulnerability"/>
    <rdfs:label>Absence of intermediate curbstone</rdfs:label>
    <rdfs:comment xml:lang="en">A vulnerability that consists in the absence of curbstones in the intermediate floors of the slabs supported by the wall.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b53">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b54"/>
    <rdf:rest rdf:nodeID="n49030e428ac1404292800e1d33196617b55"/>
  </rdf:Description>
