  <rdf:Description rdf:about="https://w3id.org/fmo#HorizontalBending">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#FailureMechanism"/>
    <rdfs:label xml:lang="en">Horizontal Bending</rdfs:label>
    <rdfs:comment xml:lang="en">A specific mechanism manifested by the expulsion of material from the top zone of the wall and the detachment of wedge-shaped bodies 
accompanied by the formation of oblique and vertical cylindrical hinges due to out-of-plane actions.</rdfs:comment>
  </rdf:Description>
