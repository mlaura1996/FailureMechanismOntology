  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b171">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b172"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
