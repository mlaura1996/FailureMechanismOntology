    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>Has occurring mechanism</rdfs:label>
    <rdfs:comment>It relates the masonry wall with the inferred occurred mechanism.</rdfs:comment>
    <rdfs:domain rdf:nodeID="nb9c367e4985148a5abcacf59dd7ea8eeb7"/>
