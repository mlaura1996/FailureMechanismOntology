    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b196"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fmo#GoodInPlaneBehaviour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#InPlaneBehaviour"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#WallBehaviour"/>
    <rdfs:label xml:lang="en">Good in plane behaviour</rdfs:label>
    <rdfs:comment xml:lang="en">A type of (in plane) wall behaviour that is considered good based on the values assigned to https://w3id.org/hmo#MasonryQualityIndex.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b65">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b66"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b122">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#MQI"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/hmo#hasMasonryQualityIndex"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b101">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label>Average out of plane behaviour</rdfs:label>
    <ns2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns2:isRuleEnabled>
    <rdfs:comment>If a Masonry Wall has a Masonry Quality Index, which has a Masonry Quality Index Total Out Of Plane Value less or equal than 7 and greater than 4, than the Masonry Wall has an average out of Plane behaviour</rdfs:comment>
    <ns1:body rdf:nodeID="n49030e428ac1404292800e1d33196617b102"/>
    <ns1:head rdf:nodeID="n49030e428ac1404292800e1d33196617b116"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b138">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b139"/>
    <rdf:rest rdf:nodeID="n49030e428ac1404292800e1d33196617b140"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b238">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
