  <rdf:Description rdf:about="https://w3id.org/fmo#DiagonalAndVerticalCracks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/dot#StructuralDamage"/>
    <rdf:type rdf:resource="https://w3id.org/fmo#Crack"/>
    <rdfs:label>Diagonal and vertical cracks</rdfs:label>
    <rdfs:comment>Diagonal and vertical cracks in the same wall.</rdfs:comment>
    <ns3:hasCausation rdf:resource="https://w3id.org/fmo#HorizontalBending"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b68">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
