    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b100"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b231">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <ns1:argument1 rdf:resource="https://w3id.org/fmo#wl"/>
    <ns1:argument2 rdf:resource="https://w3id.org/fmo#PresenceOfHorizontalThrust"/>
    <ns1:propertyPredicate rdf:resource="https://w3id.org/fmo#hasVulnerability"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n49030e428ac1404292800e1d33196617b160">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
    <rdf:first rdf:nodeID="n49030e428ac1404292800e1d33196617b161"/>
